---
/**
 * Article page: header block, optional cover image, table of contents rail,
 * the rendered body, and prev/next navigation.
 */
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';

import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Post } from '../utils/posts';
import { tagSlug } from '../utils/posts';
import { formatDate, isoDate, readingTime, readingTimeLabel } from '../utils/format';
import '../styles/prose.css';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, kind, lang, cover, coverAlt, draft, density, readingMinutes } =
  post.data;

const minutes = readingMinutes ?? readingTime(post.body);

/*
 * Labels below are English regardless of the post's language: the date format is
 * English, and mixing scripts inside one metadata line looks accidental. `lang`
 * still drives the `lang` attribute and the body typography.
 */
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  type="article"
  image={cover?.src}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  noindex={draft}
>
  <article class:list={['post', density === 'dense' && 'post--dense']}>
    <header class="post__header">
      <div class="post__meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTimeLabel(minutes)}</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
      </div>

      {/* `Note` is the default kind, so badging it would mark almost everything. */}
      {kind !== 'Note' && <span class="post__kind">{kind}</span>}

      <h1 class="post__title" lang={lang}>{title}</h1>
      <p class="post__description" lang={lang}>{description}</p>

      {
        tags.length > 0 && (
          <ul class="tag-list post__tags">
            {tags.map((tag) => (
              <li>
                <a class="tag-pill" href={`/blog/tags/${tagSlug(tag)}`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <figure class="post__cover">
          <Image src={cover} alt={coverAlt ?? ''} widths={[640, 960, 1280]} loading="eager" />
          {coverAlt && <figcaption class="figure-caption">{coverAlt}</figcaption>}
        </figure>
      )
    }

    <div class="post__body">
      <div class:list={['prose', density === 'dense' && 'prose--dense']} lang={lang}>
        <slot />
      </div>

      <aside class="post__rail">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    {
      (newer || older) && (
        <nav class="post__nav" aria-label="More posts">
          {older ? (
            <a class="post__nav-link" href={`/blog/posts/${older.id}`} rel="prev">
              <span class="eyebrow">Older post</span>
              <span class="post__nav-title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="post__nav-link post__nav-link--next" href={`/blog/posts/${newer.id}`} rel="next">
              <span class="eyebrow">Newer post</span>
              <span class="post__nav-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .post__header {
    max-width: var(--measure);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .post__kind {
    display: inline-block;
    margin-top: var(--space-sm);
    padding: 0.1em 0.6em;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .post__title {
    margin-top: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .post__description {
    margin-top: var(--space-sm);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .post__tags {
    margin-top: var(--space-md);
  }

  .post__cover {
    margin: var(--space-lg) 0 0;
  }

  .post__cover img {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .post__body {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-xl);
    /* Body column plus a TOC rail; the rail collapses away below 64rem. */
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 15rem);
    align-items: start;
  }

  .post__nav {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .post__nav-link {
    display: block;
    text-decoration: none;
    color: var(--text-muted);
  }

  .post__nav-link--next {
    text-align: right;
  }

  .post__nav-title {
    display: block;
    margin-top: var(--space-2xs);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--text);
    text-wrap: balance;
  }

  .post__nav-link:hover .post__nav-title {
    color: var(--accent);
  }

  @media (max-width: 64rem) {
    .post__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .post__rail {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .post__nav {
      grid-template-columns: 1fr;
    }

    .post__nav-link--next {
      text-align: left;
    }
  }
</style>

<script is:inline>
  /**
   * Mermaid runs in the browser because diagram layout needs real CSSOM.
   * The bundle is served from /vendor/mermaid.min.js and only loaded when the
   * page actually contains diagrams, so other posts stay light.
   */
  (function () {
    const nodes = document.querySelectorAll('.mermaid-diagram[data-mermaid]');
    if (nodes.length === 0) return;

    const load = (src) =>
      new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-mermaid-vendor]');
        if (existing) {
          if (window.mermaid) return resolve();
          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', reject, { once: true });
          return;
        }
        const script = document.createElement('script');
        script.src = src;
        script.dataset.mermaidVendor = '1';
        script.onload = () => resolve();
        script.onerror = reject;
        document.head.appendChild(script);
      });

    load('/vendor/mermaid.min.js')
      .then(() => {
        const mermaid = window.mermaid;
        if (!mermaid) throw new Error('mermaid failed to load');
        const dark = document.documentElement.dataset.theme === 'dark';
        mermaid.initialize({
          startOnLoad: false,
          theme: dark ? 'dark' : 'neutral',
          securityLevel: 'strict',
          fontFamily: 'inherit',
        });
        return Promise.all(
          Array.from(nodes).map(async (el, i) => {
            const source = el.getAttribute('data-mermaid') || '';
            try {
              const { svg } = await mermaid.render('mermaid-' + i + '-' + Date.now(), source);
              el.innerHTML = svg;
              el.removeAttribute('data-mermaid');
            } catch (error) {
              el.classList.add('mermaid-diagram--error');
              el.textContent =
                'Failed to render mermaid diagram: ' +
                (error && error.message ? error.message : error);
            }
          })
        );
      })
      .catch((error) => {
        for (const el of nodes) {
          el.classList.add('mermaid-diagram--error');
          el.textContent = 'Failed to load mermaid: ' + error;
        }
      });
  })();
</script>
