---
import { NAV, SITE } from '../site.config.mjs';

/*
 * Mark the active section.
 *
 * Both sides are normalised to have no trailing slash, because the nav hrefs end
 * in `/` while `Astro.url.pathname` may or may not, depending on how the request
 * arrived. A section link also matches by prefix, so `/blog/posts/some-slug`
 * lights up "Writing"; the home link matches exactly, since `/blog` is a prefix
 * of every other path and would otherwise stay lit everywhere.
 */
const normalise = (value: string) => value.replace(/\/+$/, '') || '/';
const path = normalise(Astro.url.pathname);

const isActive = (href: string) => {
  const target = normalise(href);
  return target === '/blog' ? path === target : path === target || path.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/blog/">{SITE.title}</a>

    <nav class="nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            class="nav__link"
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.4 6.4 4.8 4.8M19.2 19.2l-1.6-1.6M17.6 6.4l1.6-1.6M4.8 19.2l1.6-1.6" />
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.9 8.9 0 1 0 10.8 10.8Z" />
      </svg>
    </button>
  </div>
</header>
