---
import Icon from './Icon.astro';
import { SITE, SOCIAL } from '../site.config.mjs';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner shell">
    <p>© {year} {SITE.author} · <em>Infinite progress.</em></p>

    <nav class="site-footer__social" aria-label="Elsewhere">
      {
        SOCIAL.map((item) => (
          <a class="site-footer__link" href={item.href}>
            <Icon name={item.icon} size={1.2} />
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>
  </div>
</footer>
