---
/**
 * Prev/next pager shared by the post index and tag pages.
 *
 * Takes explicit URLs rather than an Astro `Page` object so it works for both
 * the hand-rolled index pagination and any future paginated route.
 */
interface Props {
  current: number;
  total: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { current, total, prevUrl, nextUrl } = Astro.props;
---

{
  total > 1 && (
    <nav class="pager" aria-label="Pagination">
      {prevUrl ? (
        <a class="pager__link" href={prevUrl} rel="prev">
          ← Newer
        </a>
      ) : (
        <span class="pager__link pager__link--disabled" aria-hidden="true">
          ← Newer
        </span>
      )}

      <span class="pager__status" aria-current="page">
        Page {current} of {total}
      </span>

      {nextUrl ? (
        <a class="pager__link" href={nextUrl} rel="next">
          Older →
        </a>
      ) : (
        <span class="pager__link pager__link--disabled" aria-hidden="true">
          Older →
        </span>
      )}
    </nav>
  )
}

<style>
  .pager {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    font-size: var(--step--1);
  }

  .pager__link {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .pager__link:hover {
    color: var(--accent);
  }

  .pager__link--disabled {
    color: var(--text-faint);
    opacity: 0.45;
  }

  .pager__status {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
</style>
