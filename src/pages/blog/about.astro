---
/**
 * About page. Edit the prose below directly — it is intentionally plain HTML in
 * an Astro page rather than a content entry, since it is a one-off.
 */
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import avatar from '../../assets/avatar.jpg';
import { SITE, FOCUS } from '../../site.config.mjs';
import '../../styles/prose.css';
---

<BaseLayout
  title="About"
  description={`About ${SITE.author} — what I work on, what shows up on this site, and how to get in touch.`}
>
  <header class="page-head">
    {/*
      The source is 224px for a 112px box, so a 2x display gets a sharp avatar.
      `layout="fixed"` stops Astro emitting a viewport-based srcset for what is a
      fixed-size image; the size itself comes from CSS below.
    */}
    <Image
      class="page-head__avatar"
      src={avatar}
      alt={`Portrait of ${SITE.author}`}
      layout="fixed"
    />
    <div>
      <p class="eyebrow">{SITE.role}</p>
      <h1 class="page-head__title">About</h1>
    </div>
  </header>

  <div class="prose about">
    <p>
      I'm {SITE.author} — an ML systems engineer working on AI infrastructure, with a primary focus
      on reinforcement learning frameworks and LLM inference. I contribute to{' '}
      <a href="https://github.com/sgl-project/sglang">SGLang</a> and{' '}
      <a href="https://github.com/PaddlePaddle/FastDeploy">FastDeploy</a>, and my goal is to make
      distributed training and inference as fast and scalable as possible, diving into the
      intersection of machine learning and systems.
    </p>

    <h2>What I work on</h2>
    <ul>
      {
        FOCUS.map((item) => (
          <li>
            <strong>{item.title}:</strong> {item.body}
            {item.links?.length ? (
              <>
                {' '}
                {item.links.map((link, index) => (
                  <>
                    {index > 0 && <span aria-hidden="true"> · </span>}
                    <a href={link.href}>{link.label}</a>
                  </>
                ))}
              </>
            ) : null}
          </li>
        ))
      }
    </ul>

    <h2>Get in touch</h2>
    <p>
      Email is <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. For anything code-related, a
      GitHub issue or discussion on the relevant repository is faster. Corrections are welcome and
      get credited.
    </p>

    <hr />

    <p><em>Infinite progress.</em></p>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    max-width: var(--measure);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .page-head__avatar {
    width: 5rem;
    height: 5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background-color: var(--bg-subtle);
    flex: none;
  }

  .page-head__title {
    margin-top: var(--space-2xs);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .about {
    margin-top: var(--space-lg);
  }

</style>
