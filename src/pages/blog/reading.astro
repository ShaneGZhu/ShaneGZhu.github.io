---
/**
 * Reading list: other people's writing, collected with a short note.
 *
 * Entries live in `src/content/reading/` as small YAML files. Nothing here is
 * republished — each item links to the original, and the note is mine.
 *
 * Visually this is a stack of bordered cards rather than the plain ruled rows the
 * article listings use, so the two pages are distinguishable at a glance. The
 * titles are set smaller and in sans rather than the serif the posts use, because
 * these are citations to scan, not pieces to read here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingList, sourceHost } from '../../utils/reading';
import { formatDate, isoDate } from '../../utils/format';

const entries = await getReadingList();

/*
 * Built here rather than inline in the markup: an apostrophe inside a JSX text
 * expression terminates it, so "I'd" cannot appear literally between {braces}.
 */
const recommendationLabel =
  entries.length === 1 ? 'One thing I recommend' : `${entries.length} things I recommend`;
---

<BaseLayout
  title="Reading"
  description="Essays and papers I recommend, each with a note on why it is worth your time."
>
  <header class="page-head">
    <h1 class="page-head__title">Reading</h1>
    <p class="page-head__sub">
      {recommendationLabel}: essays and papers worth your time. Each one links to the original.
    </p>
  </header>

  {
    entries.length > 0 ? (
      <ul class="cards">
        {entries.map((entry) => (
          <li class="card">
            {/*
              The heading holds the link, so the entry reads as a citation and the
              whole title is the click target. `rel="noopener"` because the
              destination is not ours; no `target="_blank"`, so the back button
              still works.
            */}
            <h2 class="card__title">
              <a href={entry.data.url} rel="noopener">
                {entry.data.title}
                {/* Marks the link as leaving the site. */}
                <span class="card__out" aria-hidden="true">
                  ↗
                </span>
              </a>
            </h2>

            <p class="card__note">{entry.data.note}</p>

            <p class="card__meta">
              {entry.data.author && (
                <>
                  <span>{entry.data.author}</span>
                  <span class="card__sep" aria-hidden="true">
                    ·
                  </span>
                </>
              )}
              <span class="card__host">{sourceHost(entry.data.url)}</span>
              {entry.data.sourcePublished && (
                <>
                  <span class="card__sep" aria-hidden="true">
                    ·
                  </span>
                  <time datetime={isoDate(entry.data.sourcePublished)}>
                    {formatDate(entry.data.sourcePublished)}
                  </time>
                </>
              )}
            </p>

            {
              entry.data.tags.length > 0 && (
                <ul class="tag-list card__tags">
                  {entry.data.tags.map((tag) => (
                    <li>
                      <span class="tag-pill">{tag}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </li>
        ))}
      </ul>
    ) : (
      <p class="cards__empty">
        Nothing collected yet. Add a YAML file under <code>src/content/reading/</code> — the schema is
        in <code>src/content.config.ts</code>.
      </p>
    )
  }
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .page-head__title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .page-head__sub {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  /*
   * One column of bordered cards, not a grid: the notes vary in height, so a
   * multi-column grid would leave holes and make the eye jump sideways. A single
   * column stays scannable however long each note is.
   */
  .cards {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }

  .card {
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--bg-raised);
    transition: border-color var(--transition), box-shadow var(--transition),
      transform var(--transition);
  }

  .card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  /* Smaller than a post title, and sans rather than serif. */
  .card__title {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 620;
    line-height: 1.4;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .card__title a {
    text-decoration: none;
  }

  /* Only the title tints on hover; the card's border already marks the target. */
  .card:hover .card__title a {
    color: var(--accent);
  }

  .card__out {
    margin-left: 0.35em;
    font-size: 0.85em;
    color: var(--text-faint);
  }

  .card:hover .card__out {
    color: var(--accent);
  }

  .card__note {
    margin-top: var(--space-xs);
    font-size: calc(var(--step-0) * 0.95);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .card__meta {
    margin-top: var(--space-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .card__host {
    font-variant-numeric: tabular-nums;
  }

  .card__sep {
    color: var(--border-strong);
  }

  .card__tags {
    margin-top: var(--space-xs);
  }

  .cards__empty {
    margin-top: var(--space-lg);
    color: var(--text-muted);
  }
</style>
