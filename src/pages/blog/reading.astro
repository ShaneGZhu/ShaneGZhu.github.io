---
/**
 * Reading list: other people's writing, collected with a short note.
 *
 * Entries live in `src/content/reading/` as small YAML files. Nothing here is
 * republished — each item links to the original, and the note is mine.
 *
 * Visually this is a stack of bordered cards rather than the plain ruled rows the
 * article listings use, so the two pages are distinguishable at a glance. The
 * titles are set smaller and in sans rather than the serif the posts use, because
 * these are citations to scan, not pieces to read here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingCard from '../../components/ReadingCard.astro';
import { getReadingList } from '../../utils/reading';
import '../../styles/cards.css';

const entries = await getReadingList();

/*
 * Built here rather than inline in the markup: an apostrophe inside a JSX text
 * expression terminates it, so "I'd" cannot appear literally between {braces}.
 */
const recommendationLabel =
  entries.length === 1 ? 'One thing I recommend' : `${entries.length} things I recommend`;
---

<BaseLayout
  title="Reading"
  description="Essays and papers I recommend, each with a note on why it is worth your time."
>
  <header class="page-head">
    <h1 class="page-head__title">Reading</h1>
    <p class="page-head__sub">
      {recommendationLabel}: essays and papers worth your time. Each one links to the original.
    </p>
  </header>

  {
    entries.length > 0 ? (
      <ul class="cards">
        {entries.map((entry) => (
          <ReadingCard entry={entry} />
        ))}
      </ul>
    ) : (
      <p class="cards__empty">
        Nothing collected yet. Add a YAML file under <code>src/content/reading/</code> — the schema is
        in <code>src/content.config.ts</code>.
      </p>
    )
  }
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .page-head__title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .page-head__sub {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .cards__empty {
    margin-top: var(--space-lg);
    color: var(--text-muted);
  }
</style>
