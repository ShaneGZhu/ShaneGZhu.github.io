---
/**
 * About page. Edit the prose below directly — it is intentionally plain HTML in
 * an Astro page rather than a content entry, since it is a one-off.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIAL, FOCUS } from '../site.config.mjs';
import '../styles/prose.css';
---

<BaseLayout
  title="About"
  description={`About ${SITE.author} — what I work on, what shows up on this site, and how to get in touch.`}
>
  <header class="page-head">
    <p class="eyebrow">{SITE.role}</p>
    <h1 class="page-head__title">About</h1>
  </header>

  <div class="prose about">
    <p>
      I'm {SITE.author} — an ML systems engineer working on AI infrastructure, with a primary focus
      on reinforcement learning frameworks and <a href="https://github.com/sgl-project/sglang">SGLang</a>.
      My goal is to make distributed training and inference as fast and scalable as possible,
      diving into the intersection of machine learning and systems.
    </p>

    <h2>What I work on</h2>
    <ul>
      {
        FOCUS.map((item) => (
          <li>
            <strong>{item.title}:</strong> {item.body}
            {item.href && (
              <>
                {' '}
                <a href={item.href}>{item.linkLabel ?? 'Learn more'}</a>
              </>
            )}
          </li>
        ))
      }
    </ul>

    <h2>What lands here</h2>
    <p>
      Notes I wanted to exist while debugging something: how a subsystem actually behaves under
      load, why the obvious optimization didn't help, what a benchmark was really measuring.
      Posts are in English or Chinese depending on which one the topic wants.
    </p>

    <h2>Elsewhere</h2>
    <ul>
      {SOCIAL.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>

    <h2>Get in touch</h2>
    <p>
      Email is <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. For anything code-related, a
      GitHub issue or discussion on the relevant repository is faster. Corrections are welcome and
      get credited.
    </p>

    <hr />

    <p><em>Infinite progress.</em></p>
  </div>
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .page-head__title {
    margin-top: var(--space-2xs);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .about {
    margin-top: var(--space-lg);
  }
</style>
