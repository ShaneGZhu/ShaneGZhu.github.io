---
/**
 * 404. GitHub Pages serves `/404.html` automatically for unknown paths.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not found"
  description="That page does not exist. Try the writing index or the archive to find what you were looking for."
  noindex
>
  <div class="notfound">
    <p class="eyebrow">404</p>
    <h1 class="notfound__title">This page isn't here.</h1>
    <p class="notfound__body">
      The link may be outdated, or the post may have moved. Try the
      <a href="/blog/posts/">writing index</a> or the <a href="/blog/archive/">archive</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .notfound {
    max-width: var(--measure);
    padding-block: var(--space-xl);
  }

  .notfound__title {
    margin-top: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .notfound__body {
    margin-top: var(--space-md);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .notfound__body a {
    color: var(--accent);
  }
</style>
