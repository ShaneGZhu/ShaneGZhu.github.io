---
/**
 * Tag index: every tag with a post count.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, collectTags } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout
  title="Tags"
  description="Browse every post by topic — inference internals, KV cache management, scheduling, and performance work."
>
  <header class="page-head">
    <h1 class="page-head__title">Tags</h1>
    <p class="page-head__sub">{tags.length} {tags.length === 1 ? 'topic' : 'topics'}</p>
  </header>

  {
    tags.length > 0 ? (
      <ul class="tag-grid">
        {tags.map((tag) => (
          <li>
            <a class="tag-card" href={`/tags/${tag.slug}`}>
              <span class="tag-card__label">{tag.label}</span>
              <span class="tag-card__count">{tag.count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">No tags yet.</p>
    )
  }
</BaseLayout>

<style>
  .page-head {
    max-width: var(--measure);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .page-head__title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .page-head__sub {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .tag-grid {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-xs);
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
  }

  .tag-card {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--bg-raised);
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition),
      box-shadow var(--transition);
  }

  .tag-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .tag-card__label {
    font-weight: 560;
  }

  .tag-card__count {
    color: var(--text-faint);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    margin-top: var(--space-lg);
    color: var(--text-muted);
  }
</style>
