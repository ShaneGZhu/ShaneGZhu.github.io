---
/**
 * Home page: who I am, what I work on, then the most recent writing.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, sortFeaturedFirst, collectTags } from '../utils/posts';
import { SITE, FOCUS, SOCIAL } from '../site.config.mjs';

const posts = await getPublishedPosts();
const recent = sortFeaturedFirst(posts).slice(0, 6);
const tags = collectTags(posts).slice(0, 10);
const hasMore = posts.length > recent.length;
---

<BaseLayout>
  <section class="intro">
    <p class="eyebrow">{SITE.role}</p>
    <h1 class="intro__title">Hi there, I'm {SITE.author} 👋</h1>
    <p class="intro__body">
      I'm a developer deeply passionate about <strong>AI infrastructure</strong>, with a primary
      focus on <strong>reinforcement learning frameworks</strong> and <strong>SGLang</strong>. My
      goal is to make distributed training and inference as fast and scalable as possible, diving
      into the intersection of machine learning and systems.
    </p>

    <ul class="intro__links">
      {
        SOCIAL.map((item) => (
          <li>
            <a class="intro__link" href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="focus" aria-labelledby="focus-heading">
    <h2 class="section-title" id="focus-heading">What I do</h2>
    <ul class="focus__list">
      {
        FOCUS.map((item) => (
          <li class="focus__item">
            <h3 class="focus__title">{item.title}</h3>
            <p class="focus__body">
              {item.body}
              {item.href && (
                <>
                  {' '}
                  <a href={item.href}>{item.linkLabel ?? 'Learn more'} →</a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="listing" aria-labelledby="recent-heading">
    <div class="listing__head">
      <h2 class="section-title" id="recent-heading">Recent writing</h2>
      {hasMore && <a class="listing__more" href="/posts">All posts →</a>}
    </div>

    {
      recent.length > 0 ? (
        <div class="listing__items">
          {recent.map((post, index) => (
            <PostCard post={post} featured={index === 0} />
          ))}
        </div>
      ) : (
        <p class="listing__empty">
          Nothing published yet. Add a Markdown file under <code>src/content/posts/</code> to get
          started.
        </p>
      )
    }

    {
      tags.length > 0 && (
        <ul class="tag-list listing__tags">
          {tags.map((tag) => (
            <li>
              <a class="tag-pill" href={`/tags/${tag.slug}`}>
                {tag.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <p class="sign-off">Infinite progress.</p>
</BaseLayout>

<style>
  .intro {
    max-width: var(--measure);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .intro__title {
    margin-top: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .intro__body {
    margin-top: var(--space-md);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .intro__body strong {
    color: var(--text);
    font-weight: 600;
  }

  .intro__links {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    font-size: var(--step--1);
  }

  .intro__link {
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 1px;
  }

  .intro__link:hover {
    color: var(--accent);
    border-bottom-color: currentColor;
  }

  /* Shared section label, matching the listing heading treatment. */
  .section-title {
    font-size: var(--step-0);
    font-weight: 620;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .focus {
    margin-top: var(--space-xl);
  }

  .focus__list {
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-md) var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    max-width: var(--measure-wide);
  }

  .focus__title {
    font-size: var(--step-0);
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .focus__body {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: calc(var(--step-0) * 0.96);
    line-height: 1.6;
  }

  .focus__body a {
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .focus__body a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .listing {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .listing__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .listing__more {
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .listing__more:hover {
    color: var(--accent);
  }

  .listing__items {
    margin-top: var(--space-sm);
  }

  .listing__tags {
    margin-top: var(--space-lg);
  }

  .listing__empty {
    margin-top: var(--space-md);
    color: var(--text-muted);
  }

  .sign-off {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-faint);
  }
</style>
