---
/**
 * Home page: banner, short intro, what I work on, then the latest few posts with
 * a link through to the full index.
 */
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import banner from '../assets/banner.jpg';
import { getPublishedPosts, sortFeaturedFirst } from '../utils/posts';
import { SITE, FOCUS, SOCIAL } from '../site.config.mjs';

const posts = await getPublishedPosts();
const recent = sortFeaturedFirst(posts).slice(0, SITE.postsOnHome);
const hasMore = posts.length > recent.length;
---

<BaseLayout>
  {/*
    A wide banner rather than a portrait, so it spans the full content width.
    `loading="eager"` and `fetchpriority="high"` because it is the largest
    above-the-fold element; the widths cover a phone up to a wide desktop at 2x.
  */}
  <figure class="banner">
    <Image
      src={banner}
      alt="Illustration: a girl in a black dress saluting beside a pink dragon plush"
      widths={[480, 720, 1040, 1536]}
      sizes="(max-width: 68rem) 100vw, 68rem"
      loading="eager"
      fetchpriority="high"
    />
  </figure>

  <section class="intro">
    <p class="eyebrow">{SITE.role}</p>
    <h1 class="intro__title">Hi there, I'm {SITE.author} 👋</h1>
    <p class="intro__body">
      I'm a developer deeply passionate about <strong>AI infrastructure</strong>, with a primary
      focus on <strong>reinforcement learning frameworks</strong> and{' '}
      <strong>LLM inference</strong> — contributing to <strong>SGLang</strong> and{' '}
      <strong>FastDeploy</strong>. My goal is to make distributed training and inference as fast
      and scalable as possible, diving into the intersection of machine learning and systems.
    </p>

    <ul class="intro__links">
      {
        SOCIAL.map((item) => (
          <li>
            <a class="intro__link" href={item.href}>
              <Icon name={item.icon} />
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="focus" aria-labelledby="focus-heading">
    <h2 class="section-title" id="focus-heading">What I do</h2>
    <ul class="focus__list">
      {
        FOCUS.map((item) => (
          <li class="focus__item">
            <h3 class="focus__title">{item.title}</h3>
            <p class="focus__body">
              {item.body}
              {item.links?.length ? (
                <>
                  {' '}
                  {item.links.map((link, index) => (
                    <>
                      {index > 0 && <span aria-hidden="true"> · </span>}
                      <a href={link.href}>{link.label}</a>
                    </>
                  ))}
                </>
              ) : null}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="listing" aria-labelledby="recent-heading">
    <div class="listing__head">
      <h2 class="section-title" id="recent-heading">Recent writing</h2>
      {hasMore && <a class="listing__more" href="/posts">All posts →</a>}
    </div>

    {
      recent.length > 0 ? (
        <div class="listing__items">
          {recent.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="listing__empty">
          Nothing published yet. Add a Markdown file under <code>src/content/posts/</code> to get
          started.
        </p>
      )
    }

    {
      /*
       * Always rendered. The home page is a teaser for the index, so the way
       * through has to be there even while the list still fits on one page.
       */
      <p class="listing__all">
        <a class="listing__all-link" href="/posts">
          {posts.length > recent.length ? `All ${posts.length} posts` : 'Browse all posts'} →
        </a>
      </p>
    }
  </section>

  <p class="sign-off">Infinite progress.</p>
</BaseLayout>

<style>
  /*
   * The banner spans the full content width. A fixed aspect ratio reserves the
   * space before the image loads, so the text below does not jump.
   */
  .banner {
    margin: 0;
    max-width: var(--measure-wide);
  }

  .banner img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background-color: var(--bg-subtle);
  }

  .intro {
    max-width: var(--measure);
    margin-top: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .intro__title {
    margin-top: var(--space-2xs);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .intro__body {
    margin-top: var(--space-sm);
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .intro__body strong {
    color: var(--text);
    font-weight: 600;
  }

  .intro__links {
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    font-size: var(--step--1);
  }

  .intro__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 1px;
  }

  .intro__link:hover {
    color: var(--accent);
    border-bottom-color: currentColor;
  }

  /* Shared section label, matching the listing heading treatment. */
  .section-title {
    font-size: var(--step-0);
    font-weight: 620;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .focus {
    margin-top: var(--space-xl);
  }

  .focus__list {
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-md) var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    max-width: var(--measure-wide);
  }

  .focus__title {
    font-size: var(--step-0);
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .focus__body {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: calc(var(--step-0) * 0.96);
    line-height: 1.6;
  }

  .focus__body a {
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .focus__body a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .listing {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .listing__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .listing__more {
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .listing__more:hover {
    color: var(--accent);
  }

  .listing__items {
    margin-top: var(--space-sm);
  }

  /* Second, more prominent route to the index at the end of the list. */
  .listing__all {
    margin-top: var(--space-md);
  }

  .listing__all-link {
    display: inline-block;
    padding: 0.5em 1.1em;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 560;
    text-decoration: none;
    transition: color var(--transition), border-color var(--transition),
      background-color var(--transition);
  }

  .listing__all-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background-color: var(--accent-soft);
  }

  .listing__empty {
    margin-top: var(--space-md);
    color: var(--text-muted);
  }

  .sign-off {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-faint);
  }

  @media (max-width: 34rem) {
    /*
     * The banner keeps its source 16:9 ratio at every width. Forcing a taller box
     * on a phone would crop roughly 29% of the width, and the illustration is
     * laid out so the interesting part is off-centre.
     */
    .banner img {
      border-radius: var(--radius-md);
    }

    .intro {
      margin-top: var(--space-lg);
    }
  }
</style>
