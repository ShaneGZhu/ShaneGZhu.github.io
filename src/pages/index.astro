---
/**
 * Root redirect.
 *
 * Every page lives under `/blog/`, so the domain root has nothing to serve.
 * This immediately forwards a visitor to `/blog/` rather than showing a 404 for
 * the site's own address.
 *
 * The page is not a `base` plus redirect in the Astro config: a config redirect
 * emits `<meta http-equiv="refresh">` only, which flashes a blank page before it
 * fires. Redirecting in script as well avoids that, and the meta tag plus the
 * `<noscript>` link cover JavaScript being unavailable.
 *
 * `noindex` because the root should not compete with `/blog/` in search results.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const TARGET = '/blog/';
---

<BaseLayout title="Redirecting" description="This site lives under /blog/." noindex>
  <script is:inline define:vars={{ TARGET }}>
    location.replace(TARGET);
  </script>
  <noscript>
    <p>
      This site lives under <a href={TARGET}>{TARGET}</a>.
    </p>
  </noscript>
</BaseLayout>
